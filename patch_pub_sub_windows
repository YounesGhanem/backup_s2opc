+ void SOPC_Socket_Close(SOPC_Socket* sock)
+ {
+     if (sock != NULL && *sock != SOPC_INVALID_SOCKET)
+     {
+         int res = 0;
+         //S2OPC_TEMP_FAILURE_RETRY(res, close((*sock)->sock));
+         S2OPC_TEMP_FAILURE_RETRY(res, closesocket((*sock)->sock));
+         if (res != -1)
+         {
+             SOPC_Free(*sock);
+             *sock = SOPC_INVALID_SOCKET;
+         }
+     }
+ }
